---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import TravelChannel from "@/components/TravelChannel.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import PostThumbnail from "@/components/PostThumbnail.astro";
import Datetime from "@/components/Datetime.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostExcerpt } from "@/utils/getPostExcerpt";
import { SITE } from "@/config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = [...sortedPosts]
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, 4);
const recentPosts = sortedPosts;

// 홈에 표시할 카테고리와 순서
const homepageCategories = ["블로그", "여행 및 관심사", "개발 및 도구"];

// 카테고리별 최신 글 3개씩 묶기
const categoryMap = new Map<string, typeof sortedPosts>();
for (const post of sortedPosts) {
  if (post.data.category && !post.data.draft) {
    const arr = categoryMap.get(post.data.category) ?? [];
    if (arr.length < 3) arr.push(post);
    categoryMap.set(post.data.category, arr);
  }
}
const categoryEntries = homepageCategories.map(
  category => [category, categoryMap.get(category) ?? []] as const
);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- 저자 소개 섹션 -->
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {SITE.author}
      </h1>
      <p class="my-2 leading-relaxed">생각과 경험을 기록하는 공간입니다.</p>
      <div class="mt-4 flex max-sm:flex-col sm:items-center">
        <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
        <Socials />
      </div>
    </section>

    <!-- Featured 섹션: 수직 그리드 카드 -->
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={["pt-12 pb-6", "border-b border-border"]}
        >
          <h2 class="mb-6 text-2xl font-semibold tracking-wide">Featured</h2>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {featuredPosts.map(post => {
              const { title, category, ...dtProps } = post.data;
              return (
                <li class="flex">
                  <a
                    href={`${base}${getPath(post.id, post.filePath)}`}
                    class="group flex w-full flex-col overflow-hidden rounded-lg border border-border transition-colors hover:border-accent/60 hover:bg-accent/5"
                  >
                    <PostThumbnail post={post} />
                    <div class="flex flex-1 flex-col p-4">
                      {category && (
                        <p class="text-xs font-medium opacity-70">{category}</p>
                      )}
                      <h3
                        class="mt-1 text-lg font-medium text-accent decoration-dashed group-hover:underline"
                        style={{
                          viewTransitionName: slugifyStr(
                            title.replaceAll(".", "-")
                          ),
                        }}
                      >
                        {title}
                      </h3>
                      <p class="mt-1 line-clamp-3 flex-1 text-base opacity-80">
                        {getPostExcerpt(post.body)}
                      </p>
                      <div class="mt-2">
                        <Datetime {...dtProps} />
                      </div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <!-- 카테고리별 섹션: 썸네일 카드 그리드 -->
    {
      categoryEntries.length > 0
        ? categoryEntries.map(([category, catPosts]) => (
            <section class="border-b border-border pt-12 pb-6">
              <div class="mb-6 flex items-center justify-between">
                <h2 class="text-2xl font-semibold tracking-wide">{category}</h2>
                <LinkButton
                  href={`${base}/categories/${category}/`}
                  class="group inline-block hover:text-accent"
                >
                  전체 보기
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </LinkButton>
              </div>
              {category === "여행 및 관심사" && <TravelChannel />}
              {catPosts.length > 0 && (
                <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {catPosts.map(post => {
                    const { title, ...dtProps } = post.data;
                    return (
                      <li class="flex">
                        <a
                          href={`${base}${getPath(post.id, post.filePath)}`}
                          class="group flex w-full flex-col overflow-hidden rounded-lg border border-border transition-colors hover:border-accent/60 hover:bg-accent/5"
                        >
                          <PostThumbnail post={post} />
                          <div class="flex flex-1 flex-col p-4">
                            <h3
                              class="text-lg font-medium text-accent decoration-dashed group-hover:underline"
                              style={{
                                viewTransitionName: slugifyStr(
                                  title.replaceAll(".", "-")
                                ),
                              }}
                            >
                              {title}
                            </h3>
                            <p class="mt-1 line-clamp-3 flex-1 text-base opacity-80">
                              {getPostExcerpt(post.body)}
                            </p>
                            <div class="mt-2">
                              <Datetime {...dtProps} />
                            </div>
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>
          ))
        : recentPosts.length > 0 && (
            <section id="recent-posts" class="pt-12 pb-6">
              <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
              <ul>
                {recentPosts.slice(0, SITE.postPerIndex).map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
          )
    }

    <div class="my-8 text-center">
      <LinkButton href={`${base}/posts/`}>
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", import.meta.env.BASE_URL);
    }
  });
</script>
