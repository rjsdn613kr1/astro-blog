---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = await getCollection("blog");
const publishedPosts = posts.filter(p => !p.data.draft);
const featuredCategories = ["여행 및 관심사"];

// 카테고리별 글 수 집계
const categoryMap = new Map<
  string,
  { count: number; tagCounts: Map<string, number> }
>();
for (const post of publishedPosts) {
  if (post.data.category) {
    const category = categoryMap.get(post.data.category) ?? {
      count: 0,
      tagCounts: new Map<string, number>(),
    };
    category.count += 1;
    for (const tag of post.data.tags) {
      category.tagCounts.set(tag, (category.tagCounts.get(tag) ?? 0) + 1);
    }
    categoryMap.set(post.data.category, category);
  }
}

for (const category of featuredCategories) {
  if (!categoryMap.has(category)) {
    categoryMap.set(category, { count: 0, tagCounts: new Map() });
  }
}

const categories = [...categoryMap.entries()]
  .sort((a, b) => b[1].count - a[1].count)
  .map(([name, { count, tagCounts }]) => ({
    name,
    count,
    tags: [...tagCounts.entries()]
      .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
      .slice(0, 6)
      .map(([tag]) => tag),
  }));
---

<Layout title={`Categories | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Categories" pageDesc="All the categories used in posts.">
    {
      categories.length === 0 ? (
        <p class="opacity-60">
          글에 <code>category:</code> 항목을 추가하면 여기에 표시됩니다.
        </p>
      ) : (
        <ul class="flex flex-col gap-4">
          {categories.map(({ name, count, tags }) => (
            <li>
              <a
                href={`${base}/categories/${name}/`}
                class="group flex items-center justify-between rounded-lg border border-border px-5 py-4 transition-colors hover:border-accent"
              >
                <div>
                  <span class="text-lg font-semibold transition-colors group-hover:text-accent">
                    {name}
                  </span>
                  {tags.length > 0 && (
                    <p class="mt-1 text-sm opacity-60">
                      {tags.map(tag => `#${tag}`).join(" · ")}
                    </p>
                  )}
                </div>
                <span class="ml-4 shrink-0 rounded-full bg-border px-3 py-1 text-sm font-medium">
                  {count}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
